{
  "manifest_version": 3,
  "name": "Pricebook Entries Meta Delete",
  "version": "1.0",
  "description": "Run Salesforce Pricebook Entries meta delete across all open WooCommerce product tabs",
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": ["https://moscadesign.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
