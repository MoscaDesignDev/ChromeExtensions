{
  "manifest_version": 3,
  "name": "Reload All Tabs",
  "version": "1.0",
  "description": "Reload all tabs in the current window via keyboard shortcut",
  "permissions": ["tabs"],
  "host_permissions": ["https://moscadesign.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "reload-all-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Reload all tabs in the current window"
    }
  }
}
